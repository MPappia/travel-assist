// Schéma de données de Traveler Assist.
// Les montants sont stockés en centimes (Int) pour éviter les erreurs d'arrondi.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

enum TripStatus {
  IDEA
  PLANNING
  BOOKED
  DONE
}

enum TaskCategory {
  TRANSPORT
  ACCOMMODATION
  ADMIN
  ACTIVITIES
  PACKING
  OTHER
}

enum ExpenseCategory {
  TRANSPORT
  ACCOMMODATION
  FOOD
  ACTIVITIES
  ADMIN
  OTHER
}

enum ExpenseStatus {
  ESTIMATED
  BOOKED
  PAID
}

enum CriterionType {
  NUMBER
  TEXT
  BOOLEAN
  RATING
}

enum CriterionDirection {
  HIGHER_IS_BETTER
  LOWER_IS_BETTER
}

enum ItemStatus {
  OPTION
  SELECTED
  REJECTED
}

// Type de comparatif : il active les affichages et l'extraction spécifiques (vols : segments, date de relevé…).
enum ComparisonKind {
  GENERIC
  LODGING
  FLIGHTS
}

enum PreviewStatus {
  NONE
  OK
  PARTIAL
  FAILED
}

enum RouteMode {
  DRIVING
  CYCLING
  WALKING
}

model Trip {
  id          String       @id @default(cuid())
  name        String
  destination String       @default("")
  startDate   DateTime?
  endDate     DateTime?
  travelers   Int          @default(1)
  budgetCents Int?
  status      TripStatus   @default(IDEA)
  notes       String       @default("")
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  tasks       Task[]
  expenses    Expense[]
  comparisons Comparison[]
  routes      Route[]
}

model Task {
  id        String       @id @default(cuid())
  tripId    String
  trip      Trip         @relation(fields: [tripId], references: [id], onDelete: Cascade)
  title     String
  category  TaskCategory @default(OTHER)
  dueDate   DateTime?
  done      Boolean      @default(false)
  createdAt DateTime     @default(now())

  @@index([tripId])
}

model Expense {
  id               String          @id @default(cuid())
  tripId           String
  trip             Trip            @relation(fields: [tripId], references: [id], onDelete: Cascade)
  label            String
  category         ExpenseCategory @default(OTHER)
  amountCents      Int
  status           ExpenseStatus   @default(ESTIMATED)
  // Lien optionnel vers l'élément de comparatif qui a généré la dépense (évite les doublons).
  comparisonItemId String?         @unique
  comparisonItem   ComparisonItem? @relation(fields: [comparisonItemId], references: [id], onDelete: SetNull)
  createdAt        DateTime        @default(now())

  @@index([tripId])
}

model Comparison {
  id              String           @id @default(cuid())
  tripId          String
  trip            Trip             @relation(fields: [tripId], references: [id], onDelete: Cascade)
  name            String
  // Catégorie budgétaire utilisée quand un élément retenu crée une dépense.
  expenseCategory ExpenseCategory  @default(ACCOMMODATION)
  kind            ComparisonKind   @default(GENERIC)
  createdAt       DateTime         @default(now())
  criteria        Criterion[]
  items           ComparisonItem[]

  @@index([tripId])
}

model Criterion {
  id           String             @id @default(cuid())
  comparisonId String
  comparison   Comparison         @relation(fields: [comparisonId], references: [id], onDelete: Cascade)
  name         String
  type         CriterionType      @default(NUMBER)
  weight       Float              @default(1)
  direction    CriterionDirection @default(HIGHER_IS_BETTER)
  unit         String             @default("")
  position     Int                @default(0)
  values       CriterionValue[]

  @@index([comparisonId])
}

model ComparisonItem {
  id                 String           @id @default(cuid())
  comparisonId       String
  comparison         Comparison       @relation(fields: [comparisonId], references: [id], onDelete: Cascade)
  title              String
  url                String?
  notes              String           @default("")
  status             ItemStatus       @default(OPTION)
  // Aperçu de lien (Open Graph / JSON-LD), éditable à la main.
  previewStatus      PreviewStatus    @default(NONE)
  previewImage       String?
  previewTitle       String?
  previewDescription String?
  previewSiteName    String?
  previewDomain      String?
  previewError       String?
  previewFetchedAt   DateTime?
  // Vols : date à laquelle le prix a été relevé, et détails (segments, passagers…) en JSON validé par zod
  priceCapturedAt    DateTime?
  flightDetails      String?
  createdAt          DateTime         @default(now())
  values             CriterionValue[]
  expense            Expense?

  @@index([comparisonId])
}

model CriterionValue {
  id          String         @id @default(cuid())
  itemId      String
  item        ComparisonItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  criterionId String
  criterion   Criterion      @relation(fields: [criterionId], references: [id], onDelete: Cascade)
  numberValue Float?
  textValue   String?
  boolValue   Boolean?

  @@unique([itemId, criterionId])
}

model Route {
  id        String      @id @default(cuid())
  tripId    String
  trip      Trip        @relation(fields: [tripId], references: [id], onDelete: Cascade)
  name      String
  mode      RouteMode   @default(DRIVING)
  createdAt DateTime    @default(now())
  stops     RouteStop[]

  @@index([tripId])
}

model RouteStop {
  id       String    @id @default(cuid())
  routeId  String
  route    Route     @relation(fields: [routeId], references: [id], onDelete: Cascade)
  position Int
  name     String
  lat      Float
  lng      Float
  // Date d'arrivée prévue et nombre de nuits sur place (facultatifs) pour la vue jour par jour.
  date     DateTime?
  nights   Int?
  notes    String    @default("")

  @@index([routeId])
}

// Cache générique des appels externes (aperçus de liens, géocodage, itinéraires).
model ApiCache {
  key       String   @id
  value     String
  createdAt DateTime @default(now())
}

// Import d'annonce en attente de confirmation (bookmarklet ou copier-coller), effacé après 24 h.
model PendingImport {
  id         String   @id @default(cuid())
  origin     String // "bookmarklet" | "paste"
  url        String?
  // Données brutes reçues (JSON ListingSource)
  payload    String
  // Résultat d'extraction mis en cache (JSON ListingExtraction), calculé à la première consultation
  extraction String?
  createdAt  DateTime @default(now())
  expiresAt  DateTime

  @@index([expiresAt])
}
