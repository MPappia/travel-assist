# Base SQLite locale (chemin relatif à la racine du projet)
DATABASE_URL="file:./prisma/dev.db"

# Clé OpenRouteService (https://openrouteservice.org/dev/#/signup) — utilisée uniquement côté serveur
ORS_API_KEY=""

# Identifiant envoyé dans le User-Agent des appels de géocodage (politique d'usage Photon/Nominatim)
GEOCODER_CONTACT="traveler-assist (usage personnel)"

# Adresse de l'application injectée dans le favori « Envoyer à Traveler Assist » (défaut : http://localhost:3000)
APP_URL="http://localhost:3000"

# Extraction d'annonces par LLM (facultatif) : API compatible OpenAI (/chat/completions)
# LLM_BASE_URL="http://localhost:11434/v1"
# LLM_MODEL="qwen2.5:7b-instruct"
# LLM_API_KEY=""
